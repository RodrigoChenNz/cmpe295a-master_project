request_body {
    max_size 1MB
}
header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    X-Frame-Options DENY
    Strict-Transport-Security "max-age=31536000"
    Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' wss:; frame-ancestors 'none'; base-uri 'self'"
}
@backend path /api/* /ucp/* /.well-known/* /policies/* /ws/*
handle @backend {
    reverse_proxy api:8000
}
handle {
    encode zstd gzip
    root * /srv/web
    try_files {path} /index.html
    file_server
}
