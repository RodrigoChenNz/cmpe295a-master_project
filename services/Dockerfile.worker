FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /srv
COPY requirements-worker.txt ./
RUN pip install --no-cache-dir torch==2.12.0 --index-url https://download.pytorch.org/whl/cpu && pip install --no-cache-dir -r requirements-worker.txt
COPY retail ./retail
COPY contracts ./contracts
RUN useradd --create-home --shell /usr/sbin/nologin shelfiq && mkdir -p /srv/artifacts && chown shelfiq:shelfiq /srv/artifacts
USER shelfiq
ENTRYPOINT ["python", "-m", "retail", "worker"]
