# Copy to .env and fill in. .env is gitignored — never commit real values.

MQTT_HOST=localhost
MQTT_PORT=1883

DATABASE_URL=postgresql://retail:retail_dev_only@localhost:5432/retail_pricing

VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/stream

# The seed ships every user with an unusable password hash, so that no file in
# this repo holds a working credential. On startup dashboard-api turns this one
# account into something you can sign in as. Change the password; it only ever
# lives here, and .env is gitignored.
#
# Sign in at http://localhost:5173 as rodrigo.chen@sjsu.edu with this password.
SHELFIQ_BOOTSTRAP_USER=rchen
SHELFIQ_BOOTSTRAP_PASSWORD=change-me-locally

# Set true behind https. The session is an httpOnly cookie, so over plain http
# a true value here means the browser never stores it and sign-in appears to
# succeed and then not work.
SESSION_COOKIE_SECURE=false
