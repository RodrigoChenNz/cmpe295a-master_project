# Copy to .env and fill in. .env is gitignored — never commit real values.

MQTT_HOST=localhost
MQTT_PORT=1883

DATABASE_URL=postgresql://retail:retail_dev_only@localhost:5432/retail_pricing

VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/stream

# `make demo` only. `make up` ignores these: on an empty database the first
# person to open http://localhost:5173 creates the super admin account there.
#
# The demo seed ships every user with an unusable password hash, so that no
# file in this repo holds a working credential. On startup dashboard-api gives
# this user a password and makes it the super admin. Change the password; it
# only ever lives here, and .env is gitignored.
#
# Sign in to the demo as admin@admin.com / admin (the values below).
SHELFIQ_BOOTSTRAP_USER=admin
SHELFIQ_BOOTSTRAP_EMAIL=admin@admin.com
SHELFIQ_BOOTSTRAP_NAME=Admin Admin
SHELFIQ_BOOTSTRAP_PASSWORD=admin

# Set true behind https. The session is an httpOnly cookie, so over plain http
# a true value here means the browser never stores it and sign-in appears to
# succeed and then not work.
SESSION_COOKIE_SECURE=false

# Override if another local app uses port 8000.
API_PORT=8000

# Optional non-browser agent REST principal. Empty means service access is disabled.
# Set a private random secret of at least 32 characters; never commit a real key.
# This key submits recommendations/market evidence and reads feedback. It cannot
# cast owner verdicts, manage accounts, or place a real purchase.
COMMERCE_AGENT_KEY=

# RFC 9421 HMAC order hooks: random >=32-character private shared receiver key.
# Empty key disables delivery. Empty URL with a key exercises the local signed receiver.
COMMERCE_WEBHOOK_KEY=
# Only an operator-configured HTTPS URL is allowed for external delivery.
COMMERCE_WEBHOOK_URL=
